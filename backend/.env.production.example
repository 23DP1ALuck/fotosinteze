# Set these in your backend hosting environment; keep DATABASE_URL and JWT_SECRET.
CLIENT_URL=https://fotosinteze.lat
# Preserve this key: Enable Banking uses it to encrypt stored sessions.
REVOLUT_TOKEN_ENCRYPTION_KEY=your-existing-Fernet-key

# Optional Enable Banking production app for your linked personal accounts.
ENABLE_BANKING_APP_ID=your-enable-banking-app-uuid
ENABLE_BANKING_PRIVATE_KEY_PATH=/data/enable-banking/private.pem
ENABLE_BANKING_REDIRECT_URI=https://api.fotosinteze.lat/enable-banking/callback
