# Set these in your backend hosting environment; keep DATABASE_URL and JWT_SECRET.
CLIENT_URL=https://fotosinteze.lat
REVOLUT_REDIRECT_URI=https://api.fotosinteze.lat/revolut/callback

# Keep existing sandbox credentials and encryption key. These paths must exist
# on the server (for example, mounted secret files), not only on your Mac.
REVOLUT_API_CLIENT_ID=your-existing-sandbox-client-id
REVOLUT_TRANSPORT_CERT_PATH=/run/secrets/revolut/transport.pem
REVOLUT_PRIVATE_KEY_PATH=/run/secrets/revolut/private.key
REVOLUT_CA_BUNDLE_PATH=/run/secrets/revolut/sandbox-ca-bundle.pem
REVOLUT_SIGNING_CERT_PATH=/run/secrets/revolut/signing.pem
REVOLUT_SIGNING_KID=fotosinteze-sandbox
REVOLUT_TOKEN_ENCRYPTION_KEY=your-existing-Fernet-key
