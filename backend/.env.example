DATABASE_URL=sqlite+aiosqlite:///./database.sqlite
# Secret used to sign and validate JWT access tokens.
# Replace this with a long, random value in every real environment.
JWT_SECRET=change-me-to-a-long-random-secret
# Frontend origin allowed by the backend CORS configuration.
CLIENT_URL=http://localhost:5173

# Optional Revolut Open Banking sandbox setup. Uncomment all four to enable it.
# Keep actual credentials outside the repository; ~ is expanded by the helper.
# REVOLUT_API_CLIENT_ID=your-sandbox-client-id
# REVOLUT_TRANSPORT_CERT_PATH=~/.config/fotosinteze/revolut-sandbox/transport.pem
# REVOLUT_PRIVATE_KEY_PATH=~/.config/fotosinteze/revolut-sandbox/private.key
# REVOLUT_CA_BUNDLE_PATH=~/.config/fotosinteze/revolut-sandbox/sandbox-ca-bundle.pem

# REV-02 consent flow: register these exact HTTPS URLs in the sandbox portal.
# REVOLUT_REDIRECT_URI=https://your-dev-backend.example/revolut/callback
# REVOLUT_SIGNING_CERT_PATH=~/.config/fotosinteze/revolut-sandbox/signing.pem
# REVOLUT_SIGNING_KID=fotosinteze-sandbox
# REVOLUT_TOKEN_ENCRYPTION_KEY=generate-a-Fernet-key-see-README

# Optional real personal accounts via Enable Banking (separate from Revolut sandbox).
# Register the same HTTPS callback in the Enable Banking application.
# ENABLE_BANKING_APP_ID=your-production-app-uuid
# ENABLE_BANKING_PRIVATE_KEY_PATH=~/.config/fotosinteze/enable-banking/private.pem
# ENABLE_BANKING_REDIRECT_URI=https://your-backend.example/enable-banking/callback
# Reuse REVOLUT_TOKEN_ENCRYPTION_KEY to encrypt sessions; never rotate it casually.
