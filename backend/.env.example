DATABASE_URL=sqlite+aiosqlite:///./database.sqlite
# Secret used to sign and validate JWT access tokens.
# Replace this with a long, random value in every real environment.
JWT_SECRET=change-me-to-a-long-random-secret
# Frontend origin allowed by the backend CORS configuration.
CLIENT_URL=http://localhost:5173

# Preserve this key: Enable Banking uses it to encrypt stored sessions.
# REVOLUT_TOKEN_ENCRYPTION_KEY=your-existing-Fernet-key

# Optional real personal accounts via Enable Banking.
# Register the same HTTPS callback in the Enable Banking application.
# ENABLE_BANKING_APP_ID=your-production-app-uuid
# ENABLE_BANKING_PRIVATE_KEY_PATH=~/.config/fotosinteze/enable-banking/private.pem
# ENABLE_BANKING_REDIRECT_URI=https://your-backend.example/enable-banking/callback
# Reuse REVOLUT_TOKEN_ENCRYPTION_KEY to encrypt sessions; never rotate it casually.

# Optional fast foreground refresh. Set only after confirming the bank/provider allowance.
# Automatic requests require the user to opt in and actively use a visible workspace.
# ENABLE_BANKING_AUTO_SYNC_INTERVAL_SECONDS=30
# Trust only the immediate proxy which overwrites CF-Connecting-IP. Empty by default.
# ENABLE_BANKING_TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128
